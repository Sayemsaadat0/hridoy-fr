{
  "info": {
    "name": "hridoy-fr Admin API",
    "description": "Auth API for the biologyaddabogura.com admin panel. Session is a JWT, set via an httpOnly `admin_session` cookie on login (and also returned in the login response body). Protected routes accept the token either via the cookie or an `Authorization: Bearer <token>` header. All responses use the envelope `{ status: \"success\"|\"error\", data|message }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b1e4a9d0-3c2a-4b7e-9a1a-3f0e1c2d4e5f"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Admin authentication",
      "item": [
        {
          "name": "Log in as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 'success' && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('admin_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"supersecret\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Validates credentials against the Admin collection. On success: sets an httpOnly `admin_session` cookie (JWT, 8h expiry) AND returns the same JWT in the response body (`data.token`) for non-browser/API clients. Rate limited to 5 attempts per 15 minutes per IP+email; requires a same-origin `Origin` header when present."
          },
          "response": [
            {
              "name": "Login successful",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Set-Cookie",
                  "value": "admin_session=<jwt>; HttpOnly; Path=/; SameSite=Lax; Max-Age=28800"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": \"665f1c2e4b3a1a0012ab34cd\",\n    \"email\": \"admin@example.com\",\n    \"name\": \"Admin Name\",\n    \"token\": \"<jwt>\"\n  }\n}"
            },
            {
              "name": "Validation error",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Invalid email or password\"\n}"
            },
            {
              "name": "Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Invalid credentials\"\n}"
            },
            {
              "name": "Too many attempts",
              "status": "Too Many Requests",
              "code": 429,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Retry-After",
                  "value": "900"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Too many login attempts. Try again later.\"\n}"
            },
            {
              "name": "Cross-origin request denied",
              "status": "Forbidden",
              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Cross-origin request denied\"\n}"
            }
          ]
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Requires a valid session, via either the `admin_session` cookie or an `Authorization: Bearer <token>` header (header takes precedence). No request body. Clears the `admin_session` cookie. Note: this does not server-side-revoke the JWT itself — a token used via the Authorization header remains valid elsewhere until it expires."
          },
          "response": [
            {
              "name": "Logout successful",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Set-Cookie",
                  "value": "admin_session=; HttpOnly; Path=/; Max-Age=0"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Logged out successfully\"\n}"
            },
            {
              "name": "Not authenticated",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Not authenticated\"\n}"
            }
          ]
        },
        {
          "name": "Get the current session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Reads the session from either the `Authorization: Bearer <token>` header (checked first) or the `admin_session` cookie, and returns the decoded session if valid."
          },
          "response": [
            {
              "name": "Authenticated",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"id\": \"665f1c2e4b3a1a0012ab34cd\",\n    \"email\": \"admin@example.com\",\n    \"name\": \"Admin Name\"\n  }\n}"
            },
            {
              "name": "Not authenticated",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Not authenticated\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
