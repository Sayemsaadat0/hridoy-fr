DB_USER_NAME=
DB_NAME=
DB_PASSWORD=
JWT_SECRET=

# Image uploads (programs, gallery). ImageKit dashboard → Developer options → API keys.
# Only the private key and URL endpoint are used (server-side); the public key is for future client uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Used only by `npm run seed:admin` to create/update the initial admin account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Swagger UI at /docs — on by default in development, off in production unless true
ENABLE_SWAGGER=
